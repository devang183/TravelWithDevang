# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control

# ============================================
# AWS KMS Configuration (Required for encrypted MongoDB URIs)
# ============================================
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-secret-access-key-here
AWS_KMS_KEY_ID=arn:aws:kms:eu-west-1:123456789012:key/abcd1234-5678-90ab-cdef-1234567890ab

# ============================================
# MongoDB Configuration (Encrypted - Recommended)
# ============================================
# Use the encrypt-mongo-uri.js script to generate these values
# Run: node scripts/encrypt-mongo-uri.js
ENCRYPTED_MONGODB_URI=your-encrypted-base64-string-here
ENCRYPTED_MONGODB_URI2=your-encrypted-base64-string-here

# ============================================
# MongoDB Configuration (Fallback - Not Recommended)
# ============================================
# These are only used if ENCRYPTED_MONGODB_URI is not set
# For security, you should encrypt these and use ENCRYPTED_MONGODB_URI instead
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
# MONGODB_URI2=mongodb+srv://username:password@cluster.mongodb.net/

# ============================================
# Other Environment Variables
# ============================================
# Add any other environment variables your application needs here
